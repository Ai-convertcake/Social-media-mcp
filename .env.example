META_ACCESS_TOKEN=
GOOGLE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Wrapper server. Static tokens: npm run token:new -> label:<sha256>[,label:<sha256>]
MCP_TOKEN_HASHES=
# Clerk OAuth (users must have a verified @CLERK_ALLOWED_EMAIL_DOMAIN email)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ALLOWED_EMAIL_DOMAIN=convertcake.com
# Own OAuth server (claude.ai / ChatGPT connectors): a dedicated *confidential* Clerk OAuth
# application whose redirect URI is ${PUBLIC_BASE_URL}/oauth/clerk/callback. Scopes: openid email.
MCP_CLERK_CLIENT_ID=
MCP_CLERK_CLIENT_SECRET=
# Public https URL clients use (Tailscale Funnel), no trailing slash
PUBLIC_BASE_URL=
# docker compose only
TS_AUTHKEY=
TS_HOSTNAME=social-media-mcp
